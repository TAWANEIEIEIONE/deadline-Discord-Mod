        await interaction.response.send_message("❌ **อัลบั้มยังไม่มีรูปภาพ** กรุณาใช้คำสั่ง `/add_photo` เพิ่มรูปก่อน", ephemeral=True)
        return
    view = ImageSelectView(valid_images)
    await interaction.response.send_message("👇 **ขั้นตอนที่ 1:** เลือกรูปภาพสำหรับงานนี้:", view=view, ephemeral=True)

