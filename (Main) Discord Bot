@bot.event
async def on_message(message: discord.Message):
    if message.author.bot:
        return

    # ถ้ามีการแท็กหาบอท หรือสุ่มโอกาส 30% ให้สุ่มหยิบคำด่าจากลิสต์ไปด่า
    if bot.user.mentioned_in(message) or random.random() < 0.3:
        if roast_words:
            random_roast = random.choice(roast_words)
            await message.reply(f"{message.author.mention} {random_roast}")

    await bot.process_commands(message)

