        super().__init__(timeout=60)
        self.selected_image = selected_image

    async def save_task(self, interaction: discord.Interaction, deadline: datetime, interval_hours: int = 1):
        active_tasks[interaction.channel_id] = {
            'deadline': deadline,
            'interval_minutes': interval_hours * 60,
            'selected_image': self.selected_image,
            'last_notified': datetime.now() - timedelta(minutes=interval_hours * 60)
        }
        embed = discord.Embed(title="🚀 ตั้งการแจ้งเตือนงานสำเร็จ!", color=discord.Color.brand_green())
        embed.add_field(name="📅 วันเวลาส่งงาน", value=f"`{deadline.strftime('%Y-%m-%d %H:%M')}`", inline=False)
        embed.add_field(name="⏱️ แจ้งเตือนทุกๆ", value=f"`{interval_hours} ชั่วโมง`", inline=True)
        embed.add_field(name="🖼️ รูปภาพที่ใช้", value=f"`{self.selected_image}`", inline=True)
        await interaction.response.send_message(embed=embed)

    @discord.ui.button(label="วันนี้ 18:00 น.", style=discord.ButtonStyle.primary, emoji="🌆")
    async def today_evening(self, interaction: discord.Interaction, button: discord.ui.Button):
