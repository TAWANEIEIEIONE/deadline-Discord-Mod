# ----------------------------------------------------
def generate_countdown_image(image_path: str, remaining_time_str: str) -> io.BytesIO:
    image = Image.open(image_path).convert("RGB")
    draw = ImageDraw.Draw(image)

    try:
        font = ImageFont.truetype("arial.ttf", size=int(image.height * 0.08))
    except IOError:
        font = ImageFont.load_default()

    text = f"Deadline in:\n{remaining_time_str}"
    w, h = image.width, image.height
    text_position = (int(w * 0.05), int(h * 0.70))

    shadow_offset = 3
    draw.text((text_position[0] + shadow_offset, text_position[1] + shadow_offset), text, fill="black", font=font)
    draw.text(text_position, text, fill="yellow", font=font)

    img_byte_arr = io.BytesIO()
    image.save(img_byte_arr, format='JPEG')
    img_byte_arr.seek(0)
    return img_byte_arr

