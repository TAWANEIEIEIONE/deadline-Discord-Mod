def load_roasts():
    if os.path.exists(ROAST_FILE):
        try:
            with open(ROAST_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return ["มัวแต่พิมพ์เล่นอยู่ได้ งานการไม่ทำหรือไง! ⏳", "หยุดแชทแล้วกลับไปเปิดไฟล์งานเดี๋ยวนี้! 🚨"]

def save_roasts(roast_list):
    with open(ROAST_FILE, "w", encoding="utf-8") as f:
        json.dump(roast_list, f, ensure_ascii=False, indent=4)

