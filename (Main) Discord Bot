class RenameImageModal(discord.ui.Modal):
    def __init__(self, old_filename: str):
        super().__init__(title=f'✏️ เปลี่ยนชื่อรูปภาพ')
        self.old_filename = old_filename
        name_only, ext = os.path.splitext(old_filename)
        self.new_name_input = discord.ui.TextInput(
            label='ชื่อไฟล์ใหม่ (ไม่ต้องใส่นามสกุล .jpg/.png)',
            placeholder='เช่น meme_cat_1',
            default=name_only,
            required=True
        )
        self.add_item(self.new_name_input)

    async def on_submit(self, interaction: discord.Interaction):
        _, ext = os.path.splitext(self.old_filename)
        new_name = self.new_name_input.value.strip() + ext
        old_path = os.path.join(ALBUM_DIR, self.old_filename)
        new_path = os.path.join(ALBUM_DIR, new_name)

        if os.path.exists(new_path) and old_path != new_path:
            await interaction.response.send_message("❌ **มีชื่อไฟล์นี้อยู่ในอัลบั้มแล้ว!**", ephemeral=True)
            return

        if os.path.exists(old_path):
            os.rename(old_path, new_path)
            await interaction.response.send_message(f"✅ เปลี่ยนชื่อเป็น `{new_name}` เรียบร้อย!", ephemeral=True)
        else:
            await interaction.response.send_message("❌ **ไม่พบไฟล์รูปภาพ**", ephemeral=True)

class ManageAlbumView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=120)
        self.update_select_menu()

    def update_select_menu(self):
        self.clear_items()
        images = [f for f in os.listdir(ALBUM_DIR) if f.lower().endswith(('png', 'jpg', 'jpeg', 'webp'))]
        if images:
            options = [discord.SelectOption(label=f"🖼️ {img}", value=img) for img in images[:25]]
            select = discord.ui.Select(
                placeholder="คลิกเลือกรูปภาพที่ต้องการจัดการ...",
                min_values=1,
                max_values=1,
                options=options,
                custom_id="select_image_to_manage"
            )
            select.callback = self.select_callback
            self.add_item(select)

    async def select_callback(self, interaction: discord.Interaction):
        selected_img = interaction.data['values'][0]
        sub_view = SingleImageActionView(selected_img)
        img_path = os.path.join(ALBUM_DIR, selected_img)
        file = discord.File(img_path, filename=selected_img)
        await interaction.response.send_message(
            content=f"📌 **คุณกำลังจัดการรูปภาพ:** `{selected_img}`",
            file=file,
            view=sub_view,
            ephemeral=True
        )

