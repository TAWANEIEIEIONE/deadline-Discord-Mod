        deadline = (datetime.now() + timedelta(days=1)).replace(hour=18, minute=0, second=0, microsecond=0)
        await self.save_task(interaction, deadline)

    @discord.ui.button(label="อีก 3 วันข้างหน้า", style=discord.ButtonStyle.secondary, emoji="📅")
    async def in_3_days(self, interaction: discord.Interaction, button: discord.ui.Button):
        deadline = (datetime.now() + timedelta(days=3)).replace(hour=18, minute=0, second=0, microsecond=0)
        await self.save_task(interaction, deadline)

