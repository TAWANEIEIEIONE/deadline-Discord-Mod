# นำ API Key ที่ได้จาก Google AI Studio มาวางตรงนี้
GEMINI_API_KEY = "API KEYS"
ai_client = genai.Client(api_key=GEMINI_API_KEY)

async def generate_ai_roast(user_message: str, author_name: str) -> str:
    """ฟังก์ชันส่งข้อความไปให้ AI ช่วยคิดคำแซวกวนๆ"""
    prompt = f"""
    คุณเป็นบอทดิสคอร์ดสไตล์กวนประสาท ประชดประชันแบบขำๆ (Roast) 
    ผู้ใช้ชื่อ "{author_name}" พิมพ์ข้อความว่า: "{user_message}"
    
    ช่วยคิดคำตอบกลับแบบกวนๆ ตลกๆ หรือแซวให้เขาไปทำงาน/เร่งงาน 1 สั้นๆ (ไม่เกิน 2-3 ประโยค)
    ห้ามใช้คำหยาบคายรุนแรง ให้เน้นความประชดกวนๆ ฮาๆ และใช้วาจาไม่ซ้ำใคร
    """
    try:
        response = ai_client.models.generate_content(
            model='gemini-2.5-flash',
            contents=prompt
        )
        return response.text.strip()
    except Exception as e:
        print(f"Gemini API Error: {e}")
        # สำรองกรณี API มีปัญหา
        return "รีบไปปั่นงานได้แล้ว มัวแต่พิมพ์เล่นอยู่ได้! ⏳"

# ----------------------------------------------------
# Event ตอบกลับข้อความในแชทด้วย AI
# ----------------------------------------------------
@bot.event
async def on_message(message: discord.Message):
    # ป้องกันไม่ให้บอทตอบตัวเอง หรือตอบบอทตัวอื่น
    if message.author.bot:
        return

    # สุ่มโอกาส 30% ที่จะตอบกลับด้วย AI (หรือตั้งเป็น 1.0 ถ้าอยากให้ตอบทุกข้อความ)
    if random.random() < 0.3:
        async with message.channel.typing():
            # ดึงคำตอบจาก AI
            roast_text = await generate_ai_roast(message.content, message.author.display_name)
            await message.reply(f"{message.author.mention} {roast_text}")

    # สำคัญ! ต้องมีบรรทัดนี้เพื่อให้ Slash Commands (/help, /task) ยังทำงานได้
    await bot.process_commands(message)
