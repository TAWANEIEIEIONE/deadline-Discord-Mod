    async def today_evening(self, interaction: discord.Interaction, button: discord.ui.Button):
        now = datetime.now()
        deadline = now.replace(hour=18, minute=0, second=0, microsecond=0)
        if deadline < now:
            deadline += timedelta(days=1)
        await self.save_task(interaction, deadline)

