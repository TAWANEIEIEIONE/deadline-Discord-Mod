# ----------------------------------------------------
# Loop & Run
# ----------------------------------------------------
@tasks.loop(minutes=1)
async def reminder_loop():
    now = datetime.now()
    for channel_id, task in list(active_tasks.items()):
        channel = bot.get_channel(channel_id)
        if not channel:
            continue

        deadline = task['deadline']
        last_notified = task['last_notified']
        interval_minutes = task['interval_minutes']

        if now >= last_notified + timedelta(minutes=interval_minutes):
            time_left = deadline - now

            if time_left.total_seconds() <= 0:
                embed = discord.Embed(
                    title="🚨 หมดเวลาส่งงานแล้ว! (DEADLINE REACHED)", 
                    description="งานในช่องนี้ถึงกำหนดส่งเรียบร้อยแล้ว", 
                    color=discord.Color.red()
                )
                await channel.send(embed=embed)
                del active_tasks[channel_id]
                continue

            if task['selected_image'] == "random":
                images = [f for f in os.listdir(ALBUM_DIR) if f.lower().endswith(('png', 'jpg', 'jpeg', 'webp'))]
                if not images:
                    continue
                chosen_image_path = os.path.join(ALBUM_DIR, random.choice(images))
            else:
                chosen_image_path = os.path.join(ALBUM_DIR, task['selected_image'])

            days_left = time_left.days
            hours_left, remainder = divmod(time_left.seconds, 3600)
            minutes_left, _ = divmod(remainder, 60)
            countdown_str = f"{days_left}d {hours_left}h {minutes_left}m"

            img_bytes = generate_countdown_image(chosen_image_path, countdown_str)
            file = discord.File(fp=img_bytes, filename="countdown.jpg")

            await channel.send(
                content=f"🔔 **แจ้งเตือนงาน!** เหลือเวลาอีกประมาณ `{days_left} วัน {hours_left} ชั่วโมง {minutes_left} นาที`", 
                file=file
            )

            task['last_notified'] = now

@bot.event
async def on_ready():
    print(f'🤖 บอท {bot.user} ล็อกอินสำเร็จแล้ว!')
    if not reminder_loop.is_running():
        reminder_loop.start()

bot.run('TOKEN')




