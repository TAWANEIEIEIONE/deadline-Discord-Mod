class CustomTaskModal(discord.ui.Modal):
    def __init__(self, selected_image: str):
        super().__init__(title='📌 กำหนดวันเวลาด้วยตัวเอง')
        self.selected_image = selected_image

        self.date_input = discord.ui.TextInput(
            label='1. วันที่ส่งงาน (ปี-เดือน-วัน)',
            placeholder='เช่น 2026-08-15',
            default=datetime.now().strftime("%Y-%m-%d"),
            required=True
        )
        self.time_input = discord.ui.TextInput(
            label='2. เวลาส่งงาน (ชั่วโมง:นาที)',
            placeholder='เช่น 21:40 หรือ 18:00',
            default='18:00',
            required=True
        )
        self.interval_hours = discord.ui.TextInput(
            label='3. แจ้งเตือนทุกๆ กี่ชั่วโมง',
            placeholder='1',
            default='1',
            required=True
        )

        self.add_item(self.date_input)
        self.add_item(self.time_input)
        self.add_item(self.interval_hours)

    async def on_submit(self, interaction: discord.Interaction):
        raw_date = self.date_input.value.strip().split()[0]
        raw_time = self.time_input.value.strip().replace('.', ':')

        full_datetime_str = f"{raw_date} {raw_time}"

        try:
            deadline = datetime.strptime(full_datetime_str, "%Y-%m-%d %H:%M")
        except ValueError:
            await interaction.response.send_message(
                "❌ **รูปแบบวันหรือเวลาไม่ถูกต้อง!**\n- ช่องวันที่: `2026-08-09`\n- ช่องเวลา: `21:40`", 
                ephemeral=True
            )
            return

        try:
            h = int(self.interval_hours.value)
        except ValueError:
            await interaction.response.send_message("❌ **กรุณากรอกตัวเลขชั่วโมงเป็นตัวเลขเท่านั้น**", ephemeral=True)
            return

        active_tasks[interaction.channel_id] = {
            'deadline': deadline,
            'interval_minutes': h * 60,
            'selected_image': self.selected_image,
            'last_notified': datetime.now() - timedelta(minutes=h * 60)
        }

        embed = discord.Embed(title="🚀 ตั้งการแจ้งเตือนงานสำเร็จ!", color=discord.Color.brand_green())
        embed.add_field(name="📅 วันเวลาส่งงาน", value=f"`{deadline.strftime('%Y-%m-%d %H:%M')}`", inline=False)
        embed.add_field(name="⏱️ แจ้งเตือนทุกๆ", value=f"`{h} ชั่วโมง`", inline=True)
        embed.add_field(name="🖼️ รูปภาพที่ใช้", value=f"`{self.selected_image}`", inline=True)

        await interaction.response.send_message(embed=embed)

